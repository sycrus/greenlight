# Greenlight v0.1 — Environment Variables
#
# After running ../scripts/setup-gcp.sh, copy values from greenlight/.env.gcp

# GCP
GCP_PROJECT_ID=greenlight-1
GCP_SERVICE_ACCOUNT_EMAIL=greenlight-agent@greenlight-v01.iam.gserviceaccount.com
GCP_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
VERTEX_LOCATION=asia-southeast1

# GCS
GCS_BUCKET_NAME=greenlight-assets

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Approval gate emails (for Slides deck sharing)
ECD_EMAIL=ecd@agency.com
CLIENT_EMAIL=client@brand.com

# Optional — Use DeepSeek instead of Gemini for LLM calls (much cheaper)
# Get a key at https://platform.deepseek.com/api_keys
# When set, all Gemini calls route through DeepSeek's API instead.
# DEEPSEEK_API_KEY=sk-...

# ComfyUI — local image generation (free, runs on your GPU)
# Set to your ComfyUI server URL. Default: http://localhost:8188
# COMFYUI_URL=http://localhost:8188

# Optional — Google AI API key for Imagen image generation (free tier available)
# Get one at https://aistudio.google.com/apikey
# Without this, image generation falls back to visible placeholders.
GEMINI_API_KEY=

# Optional — for local Firestore emulator (TDD)
# FIRESTORE_EMULATOR_HOST=localhost:8080
